<Page x:Class="NetflixWebXbox.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Background="#101012">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="Toolbar" Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="24,10">
      <TextBlock Text="NETFLIX WEB · PROEF" FontSize="20" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Button Content="Start" Click="Home_Click"/>
      <Button Content="Terug" Click="Back_Click"/>
      <Button Content="Vernieuw" Click="Reload_Click"/>
      <Button Content="Volledig scherm" Click="Full_Click"/>
      <Button Content="Open browser" Click="Browser_Click"/>
    </StackPanel>
    <controls:WebView2 x:Name="Web" Grid.Row="1"/>
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="24,8" Text="Browser starten…" TextWrapping="Wrap" Foreground="#CCCCCC"/>
  </Grid>
</Page>